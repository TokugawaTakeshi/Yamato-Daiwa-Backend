{
  "name": "@yamato-daiwa/backend",
  "version": "0.5.0",
  "description": "Backend framework with build-in TypeScript type safety. Intended to be used in full-stack applications where both client and server part written in TypeScript.",
  "keywords": [
    "backend",
    "framework",
    "web",
    "http",
    "https",
    "rest",
    "restful",
    "router",
    "controller",
    "api"
  ],
  "author": {
    "name": "Takeshi Tokugawa",
    "email": "tokugawa.takesi@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0"
  },
  "homepage": "https://backend-es.yamato-daiwa.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/TokugawaTakeshi/yamato_daiwa-backend.git"
  },
  "bugs": {
    "url": "https://github.com/TokugawaTakeshi/yamato_daiwa-backend/issues"
  },
  "main": "./Distributable/index.js",
  "types": "./Distributable/index.d.ts",
  "files": [
    "Distributable",
    "favicon.ico"
  ],
  "peerDependencies": {
    "@yamato-daiwa/es-extensions": "~1.9.0",
    "@yamato-daiwa/es-extensions-nodejs": "~1.9.0"
  },
  "dependencies": {
    "@types/pug": "2.0.10",
    "@types/qs": "6.15.1",
    "fundamental-constants": "0.9.0",
    "handlebars": "4.7.10",
    "pug": "3.0.4",
    "qs": "6.16.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@yamato-daiwa/es-extensions": "1.9.4",
    "@yamato-daiwa/es-extensions-nodejs": "1.9.4",
    "@yamato-daiwa/style_guides": "0.15.0",
    "nodemon": "3.1.14",
    "rimraf": "6.1.3",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "scripts": {
    "Check Types": "tsc --noEmit",
    "Lint": "eslint Source Tests",
    "Run Tests": "node --require tsx/cjs --test \"Tests/**/*.test.ts\"",
    "Rebuild Distributable Without Preliminary Cleaning": "tsc -p tsconfig.build.json",
    "Rebuild Distributable": "rimraf Distributable && tsc -p tsconfig.build.json",
    "Rebuild Distributable and Realize Alpha": "npm run \"Rebuild Distributable\" && npm publish --tag alpha",
    "Rebuild Distributable and Realize RC": "npm run \"Rebuild Distributable\" && npm publish --tag rc"
  },
  "funding": [
    "https://github.com/TokugawaTakeshi/Yamato-Daiwa-Backend?sponsor=1"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
