        иметь #[+Keyphrase--YDID один из] следующих #[+Keyword--YDID двух] #[+Term--YDID типов]:

    ul.Article-UnorderedList

      li.
        #[+Keyword--YDID Любой] #[+Term--YDID класс], #[+Keyword--YDID наследующий]
          #[+ImportantEntity__Code--YDID Controller], при этом нужно указать именно
