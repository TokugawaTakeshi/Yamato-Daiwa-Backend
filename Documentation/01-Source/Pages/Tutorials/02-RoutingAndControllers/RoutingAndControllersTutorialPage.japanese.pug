extends ../../../../node_modules/@yamato-daiwa/programming_documentation/Layouts/TwoColumns/TwoColumnsLayout.pug


block append Requirements

  include ../../../SharedAssets/Markup/SharedAssets.japanese.pug
  include ../../../SharedComponents/SharedComponents.japanese.pug


block append Metadata

  -

    const {
      $heading: topHeading,
      $sectioning: localizedSectioning
    } = routing.japanese.tutorials.$children.routingAndControllers;

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: buildHTML_PageTitle(topHeading),
        description:
          "Node.jsフレームワーク「Yamato Daiwa Backend」（略称：「YDB」）では、" +
            "コントローラークラスを使用する方法と、使用せずにルーティングを設定する方法の両方が可能だ。"
      },
      stylesSheetsURIs: [
        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    YDF.RoutingEmulator.setCurrentRoute("tutorials.routingAndControllers");

    LanguageDropDownList__YDF_DK.setLinks({
      english: routing.english.tutorials.$children.routingAndControllers.$URI,
      russian: routing.russian.tutorials.$children.routingAndControllers.$URI
    });


block append HeadScripts

  if __IS_PRODUCTION_BUILDING_MODE__

    +GoogleAnalyticsScript


block append SpecificContent

  article

    //- ━━━ ルーティングとコントローラー ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    h1.Article-Heading1= topHeading

    +TutorialCodeIsNotOpimizedForProductionWarning


    //- ┅┅┅ 理論 ┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅
    +Heading--YDF({
      level: 2,
      text: localizedSectioning.theory.$heading,
      HTML_ID: localizedSectioning.theory.$anchor
    }).Article-Heading2


    //- ╍╍╍ URL, URN, URI ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      text: localizedSectioning.theory.$children.URL_URN_URI.$heading,
      HTML_ID: localizedSectioning.theory.$children.URL_URN_URI.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      #[+ImportantEntity--YDID URL]（#[+Term--YDID Unified Resource Locator]）、
        #[+ImportantEntity--YDID URN]（#[+Term--YDID Unified Resource Name]）、
        #[+ImportantEntity--YDID URI]（#[+Term--YDID Unified Resource Identifier]）という用語の違いや、
        それらの要素への分解方法は、#[+Keyphrase--YDID 情報源に依って異なる場合が有る]。
      #[+ImportantEntity--YDID URL]、#[+ImportantEntity--YDID URN]、#[+ImportantEntity--YDID URI]の構造（アトナミー）は
        #[+Keyphrase--YDID フレームワークに依存しない]基礎知識だが、
        #[+ImportantEntity--YDID YDB]に於いて具体的にどの様な解釈が適用されるかを此処で定義しておく#[+Keyword--YDID 必要]が
        #[+Keyword__Contrast--YDID 有る]。

    p.Article-Paragraph.
      先ずは、現時点では#[+ImportantEntity--YDID URL]と#[+ImportantEntity--YDID URN]の違いについて議論する必要は#[+Keyword--YDID ない]。
      現在重要なのは、#[+ImportantEntity--YDID URI]が#[+ImportantEntity--YDID URL]と#[+Term--YDID URN]を#[+Keyword--YDID 包含する]
        #[+Keyword--YDID 完結した]実体であるという事。
      そして、#[+ImportantEntity--YDID URL]と#[+Term--YDID URN]が被っているかどうか、解説は#[+Keyphrase--YDID 情報源に依ってい違う]。

    p.Article-Paragraph.
      #[+ImportantEntity--YDID URI]の概念がインターネット以外にもローカルコンピュータ上のファイル等にも適用されるが、
        今は#[+Keyphrase--YDID ウェブ開発における#[+Term--YDID URI]]の特徴に焦点を当てる。


    //- ─── URI解剖 ─────────────────────────────────────────────────────────────────────────────────────────────────────
    +Heading--YDF({
      level: 4,
      text: localizedSectioning.theory.$children.URL_URN_URI.$children.URI_Anatomy.$heading,
      HTML_ID: localizedSectioning.theory.$children.URL_URN_URI.$children.URI_Anatomy.$anchor
    }).Article-Heading4

    p.Article-Paragraph.
      #[+ImportantEntity--YDID URI]の重要な構成要素を見ていこう。
      此処では正規定義よりも、これ等の要素をどの様に使用するかに重点を置く為、以下の用語集は定義では#[+Keyword--YDID なく]
        #[+Keyword__Contrast--YDID 説明]として提示する。

    +SingleImageViewer--YDF({
      imageURI: "@AssociatedWithPages/Tutorials/02-RoutingAndControllers/Images/URI_Decomposition.svg",
      imageAlternateText: "URIの分解。要素はプロトコル、ドメイン、ポート、ソケット、パス等。"
    })

    dl.Article-DescriptionList

      dt プロトコル (Protocol)
      dd 現時点では、#[+ImportantEntity--YDID HTTP]及び#[+ImportantEntity--YDID HTTPS]プロトコルに注目する。

      dt IPアドレス (IP address)
      dd.
        ローカル開発の場合、殆どは#[+Keyword--YDID ローカル]な#[+Term--YDID IPアドレス]
          （#[+Keyword--YDID 通常]は#[+ImportantEntity--YDID 127.0.0.1]、#[+Keyword--YDID エリアス]#[+Term--YDID localhost]）
          を使用する。
        サイトやアプリケーションをサーバーにデプロイする際は、サーバーのレンタルプロバイダーから発行された#[+Term--YDID IPアドレス]になるが、
          #[+Keyword--YDID サーバー上]此の#[+Term--YDID IPアドレス]の#[+Term--YDID localhost]になっている。
        #[+Term--YDID ドメイン名]を取得して此の#[+Term--YDID IPアドレス]に紐付ける事で、#[+Term--YDID IPアドレス]の#[+Keyword--YDID 代わり]に
          其の#[+Term--YDID ドメイン名]を使用出来る様に成る。

      dt ドメイン (Domain)
      dt ドメイン名 (Domain name)
      dd.
        #[+Term--YDID ドメイン名]は主にサイトやアプリケーションの公開段階で必要に成る。
        技術的な側面以外に、#[+Term--YDID ドメイン名]は#[+Keyword--YDID ブランディング]の#[+Keyword__Contrast--YDID 一部]でもある。
        然し、サイトやアプリケーションを開発する際は、ドメインの移行が簡単（理想的にはソースコードを変更せずに）に成る様に対策を講じる必要が有る。

      dt ポート (Port)
      dd.
        #[+Term--YDID ポート]は多数（具体的には#[+ImportantEntity--YDID 65535個]）存在する為、1台のサーバーで複数のサイトやアプリケーションを
          実行出来る。
        #[+Keyword--YDID 一部の]#[+Term--YDID ポート]はソフトウェアに依って様々な目的で使用されるが、此処では#[+Term--YDID HTTPリクエスト]を
          処理する為の1つ、#[+Keyword--YDID 最大で]#[+ImportantEntity--YDID 2つ]（#[+ImportantEntity--YDID HTTP]と
          #[+ImportantEntity--YDID HTTPS]の両方をサポートする場合）の#[+Term--YDID ポート]に注目する。

      dt ソケット (Socket)
      dd.
        #[+Term--YDID ドメイン]と#[+Term--YDID ポート]の#[+Keyword--YDID 組み合わせ]。
        #[+Keyphrase--YDID #[+Term--YDID ソケット]の一部#[+Keyword--YDID ではない]#[+Term--YDID プロトコル]に依って]、
          #[+Keyword--YDID 規定の]#[+Term--YDID ポート]番号が有り、
          #[+Keyphrase--YDID #[+Term--YDID ポート]番号が該当している#[+Term--YDID ポート]に対して規定になっている限り]、
          #[+Term--YDID ポート]番号を飛ばしてもも#[+Keyword--YDID 良い]。
        例えば、#[+Keyphrase--YDID プロトコルが#[+SecondaryEntity__Code--YDID HTTPS]になっている限り]
          #[+SecondaryEntity__Code--YDID https://example.com:443]は
          #[+SecondaryEntity__Code--YDID https://example.com]と#[+Keyword--YDID 同じ]である。

      dt オリジン (Origin)
      dd #[+Keyword--YDID プロトコル]、#[+Term--YDID ドメイン]、#[+Term--YDID ポート]の#[+Keyword--YDID 組み合わせ]。

      dt パス (Path)
      dd.
        此の部分こそ#[+Term--YDID ルーティング]に於いて#[+Keyword--YDID 最も]重要だ。
        #[+Keyword--YDID 通常]、此れに応じて異なるデータが返されるからだ（サイトやアプリケーション開発では主に#[+ImportantEntity--YDID JSON]形式や
          #[+ImportantEntity--YDID HTML]形式）。
        #[+Term--YDID スラッシュ]で区切られた#[+Term--YDID セグメント]は複数存在し得るが、多すぎると#[+Term--YDID ルーティング]が複雑に成る。

      dt クエリパラメータ (Query parameters)
      dd.
        通常、#[+Term--YDID パス]に基づいて返される特定のデータセット#[+Keyword--YDID 内]での検索・フィルタリングに使用される。
        但し、上記がよく有る事はあるが、特定の#[+Term--YDID クエリパラメータ]が返されるデータにどの様に影響するかは実装次第の事だ。

      dt ハッシュ (Hash)
      dd.
        此の部分は通常サーバー側のリクエスト処理では#[+Keyword--YDID 扱われず]、クライアント側（フロントエンド）でのみ意味を持つ。

    p.Article-Paragraph.
      #[+ImportantEntity--YDID URL]と#[+ImportantEntity--YDID URN]の#[+Keyphrase--YDID 解釈の一つ]によれば、
        #[+ImportantEntity--YDID URL]は#[+Term--YDID オリジン]と同じであり、#[+ImportantEntity--YDID URN]は#[+Term--YDID パス]
        から始まる部分を指す。
      従って、#[+ImportantEntity--YDID URL]と#[+ImportantEntity--YDID URN]を結合すると#[+ImportantEntity--YDID URI]に成るはず。
      然し、多くのプログラムインターフェースや日常生活に於いて、#[+ImportantEntity--YDID URL]という用語はしばしば
        #[+ImportantEntity--YDID URI]の同義語として、或いは#[+ImportantEntity--YDID URI]の何れかの部分を指して使用される。
      例えば、標準的な#[+ImportantEntity--YDID Node.js]の機能ではあるが、#[+ImportantEntity__Code--YDID http]モジュールの
        #[+ImportantEntity__Code--YDID request]#[+Term--YDID オブジェクト]の#[+ImportantEntity__Code--YDID url]
        #[+Term--YDID プロパティに]は#[+Term--YDID パス]と#[+Term--YDID クエリパラメータ]が含まれている
        （公式ドキュメントの例：#[+SecondaryEntity__Code--YDID "/status?name=ryan"]）。
      只、#[+SecondaryEntity__Code--YDID new URL(`https://${process.env.HOST ?? 'localhost'}${request.url}`);]という例だと、
        再帰そうに見えて、#[+ImportantEntity--YDID URL]がそもそも何か、此の例からだけは言えないだろう。


    //- ╍╍╍ 実体（エンティティ）の操作 ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      text: localizedSectioning.theory.$children.workingWithEntities.$heading,
      HTML_ID: localizedSectioning.theory.$children.workingWithEntities.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      #[+Term--YDID ルーティング]を本格的に考察するには、其れが通常どの様な目的で使用されるかを理解する必要が有る。
      一般的なサーバーアプリケーションに於いて、#[+Term--YDID ルーティング]の目的は#[+Keyphrase--YDID データ操作]を可能にする事だ。
      然し「データ操作」は抽象的すぎ、もう少し具体化すると「オブジェクトの操作」或いは「実体（エンティティ）の操作」と成る。
      とは言え、「オブジェクト」も「エンティティ」も未だ意味が幅広い用語なので混乱しやすいが、#[+Keyphrase--YDID 概念レベル]では、ユーザー、商品、
        ブログの記事等、現実の物品や人物に対応する情報の#[+Keyword--YDID 集合]を指す。
      此れらは、データベースのテーブルの行や、#[+Term--YDID 連想配列]の値や、
        #[+Keyphrase--YDID #[+Term--YDID オブジェクト指向プログラミング]的な意味での]#[+Term__Contrast--YDID オブジェクト]等として表現される。

    p.Article-Paragraph.
      #[+Term__Contrast--YDID バックエンド開発]用#[+Term--YDID フレームワーク]が使用される主な目的の一つは、データの操作を簡単にする事だ。
      もしデータが時間の経過と共に変化しないのであれば、サーバー側のプログラミングは不要な場合が多い。
      実体（エンティティ）に対する主な操作の種類は以下の通りだ。

    ul.Article-UnorderedList
      li 特定の条件を満たす実体の取得（絞り込み、フィルタリング）
      li ユニークな特徴を持つ特定の実体の検索
      li 新しい実体の作成
      li 既存の実体の変更
      li 実体の削除

    +AdmonitionBlock--YDF({
      SVG_Icon: true,
      geometricVariation: AdmonitionBlock__YDF.GeometricVariations.stickyNoteLike,
      decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.notice
    }).
      実体を弄る概念はITで生まれたものではなく、古来より存在していた。
      例えば、新しいリンゴを倉庫に持ってくる（オブジェクトの作成）行為や、逆にリンゴを取り出す行為や、腐ったリンゴをすべて見つける（フィルタリング）行為や、
        そしてそれらを捨てる（削除）といった行為だ。
      然し、随分逆説的ではあるが、抽象度が高いITこそ、サイトやアプリケーションの実装する時、実体の操作は明示的なものとなったが、日常生活では其れを意識する
        事は少ない。


    //- ╍╍╍ HTTPメソッド　╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      text: localizedSectioning.theory.$children.HTTP_Methods.$heading,
      HTML_ID: localizedSectioning.theory.$children.HTTP_Methods.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      上記通り、サーバーのレスポンスはどの#[+ImportantEntity--YDID URI]に対して#[+Term--YDID HTTPリクエスト]が送信されたかに依存する。
      但し、特定のサイトやアプリケーションのサーバー側開発に限って話しをすると、#[+Term--YDID オリジン]が#[+Keyword--YDID 固定]なので、
        #[+Term--YDID 応答]は#[+Keyphrase--YDID 主に]#[+Term--YDID パス]と#[+Term--YDID クエリパラメータ]に依存。
      然し、サーバーの応答に影響を与えるもう一つの要因がある、即ち#[+ImportantEntity--YDID URI]の一部に#[+Keyword--YDID なっていない]
        #[+Term--YDID HTTPメソッド]というものだ。
      本質的に、#[+DefinableTerm--YDID HTTPメソッド]とは#[+Term--YDID HTTPリクエスト]の#[+Keyword--YDID 種類]であり、
        各種類が特徴を持ち、#[+Keyphrase--YDID ルートを論理的なグループ化]する事は重要な役割。

    p.Article-Paragraph.
      最も一般的な#[+Term--YDID HTTPメソッド]を列挙する前に、よく見落とされる幾つかの点に注意しよう。

    +AdmonitionBlock--YDF({
      title: "HTTPメソッドに関する重要な情報",
      SVG_Icon: true,
      geometricVariation: AdmonitionBlock__YDF.GeometricVariations.stickyNoteLike,
      decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.guidance
    })
      ul.Article-UnorderedList

        li.
          #[+Term--YDID HTTPメソッド]の名称は#[+Keyphrase--YDID #[+Keyword--YDID 規約]に過ぎなく]、具体的な効果は
            #[+Keyword--YDID 完全に]実装次第。
          例えば、#[+SecondaryEntity--YDID DELETE]という#[+Term--YDID HTTPメソッド]名の直訳は「削除」になっていても、
            何も削除せずに逆に何かを作成する様に実装する事が理論上には可能な事だ。
          一方で、#[+Term--YDID ルーティング]を混乱させるべきではないため、実装はメソッドの名称に沿ったものであるべきだ。

        li.
          #[+Term--YDID ルーティング]を依り論理的で分かりやすくする為には、少なくとも#[+ImportantEntity--YDID 3〜4つ]の
            #[+Keyword--YDID 複数]のメソッドを使用するのが望ましい。
          とはいえ、此れは#[+Keyword--YDID 推奨]事項であり、技術的な要件では#[+Keyword__Contrast--YDID ない]。
          現在でも#[+SecondaryEntity--YDID GET]と#[+SecondaryEntity--YDID POST]の2つの#[+Term--YDID HTTPメソッド]だけで済ませている
            プロジェクトも多く、初心者の中には他の#[+SecondaryEntity--YDID HTTPメソッド]の存在すら知らない者も居る。

    p.Article-Paragraph.
      さて、#[+Keyword--YDID 最も]#[+Keyword__Contrast--YDID 人気な]#[+Term--YDID HTTPメソッド]は以下の通りだ。

    dl.Article-DescriptionList

      dt GET
      dd.
        単一の実体かこれらのコレクションを#[+Keyword--YDID 取得]するのに一般的に使われている。
        ところで、ブラウザでページを開く時は此の#[+Term--YDID GETリクエスト]が送信される、一般的なブラウザに於いて、開発者ツールやプラグインを使用せずに他
          の種類の#[+Term--YDID HTTPリクエスト]を送信する事は#[+Keyword--YDID 不可能]。

      dt PUT
      dd.
        実体の#[+Keyword--YDID 作成]#[+Keyword__Contrast--YDID 又は]#[+Keyword--YDID 完全な]#[+Keyword--YDID 変更]のに
          一般的に使われている。
        然し、#[+Keyphrase--YDID 実践上]実体が#[+ImportantEntity--YDID 100%]変更される事は
          #[+Keyword--YDID 極めて]#[+Keyword__Contrast--YDID 稀]で、通常実体には其の存続期間中変更されないユニークな識別子が有る様な事
          は理由だ。

      dt PATCH
      dd.
        実体の#[+Keyword--YDID 部分的な]#[+Keyword__Contrast--YDID 変更]のに一般的に使われている。

      dt POST
      dd.
        実践上#[+ImportantEntity--YDID PUT]や#[+ImportantEntity--YDID PATCH]に対する#[+Keyword--YDID 包括的な]メソッドであり、
          それらの代わりに使用される事が多い。

      dt DELETE
      dd.
        実体の#[+Keyword--YDID 削除]のに一般的に使われている。

    p.Article-Paragraph.
      此の様に、#[+Keyword--YDID 全く]#[+Keyword__Contrast--YDID 同じ]#[+ImportantEntity--YDID URI]であっても、
        #[+Term--YDID HTTPメソッド]に依って#[+Keyword--YDID 異なる]効果を持たせる事が出来る。
      例えば、

    dl.Article-DescriptionList

      dt [GET] https://example.com/api/users/1
