        #[+Keyword--YDID независимых] #[+Term--YDID объекта], но #[+Keyword--YDID набор] #[+Keyword__Contrast--YDID всех]
        #[+Term--YDID свойств] и их значений] #[+Keyword--YDID должен] #[+Keyword--YDID совпадать]
        #[+Keyphrase--YDID вне зависимости от уровней вложенности]).

    p.Article-Paragraph.
