        @Controller.RouteHandler({
          HTTP_Method: HTTP_Methods.get,
          pathTemplate: "products"
        })
        public async generateProductsPage(request: Request, response: Response): Promise<void> {

          const {
            fullOrPartialProductTitle,
            paginationPageNumber,
            itemsCountPerPaginationPage,
          }: Readonly<{
            fullOrPartialProductTitle: string;
            paginationPageNumber: number;
            itemsCountPerPaginationPage: number;
          }> = request.validateAndProcessURI_QueryParameters({
            fullOrPartialProductTitle: {
              type: String,
              isUndefinedForbidden: false,
              isNullForbidden: true,
              minimalCharactersCount: 2
            },
            paginationPageNumber: {
              preValidationModifications: convertPotentialStringToNumberIfPossible,
              type: Number,
              isUndefinedForbidden: true,
              isNullForbidden: true,
              isNaN_Forbidden: true,
              numbersSet: RawObjectDataProcessor.NumbersSets.naturalNumber
            },
            itemsCountPerPaginationPage: {
              preValidationModifications: convertPotentialStringToNumberIfPossible,
              type: Number,
              isUndefinedForbidden: true,
              isNullForbidden: true,
              isNaN_Forbidden: true,
              numbersSet: RawObjectDataProcessor.NumbersSets.naturalNumber
            }
          });

          console.table({
            fullOrPartialProductTitle,
            paginationPageNumber,
            itemsCountPerPaginationPage
          });

          return response.submitWithSuccess({
            HTML_Content: "<h1>Products list</h1>"
          });

        }

    p.Article-Paragraph.
      #[+Keyphrase--YDID По умолчанию], #[+ImportantEntity--YDID YDB] использует метод
        #[+ImportantEntity__Code--YDID parse] библиотеки
        #[+Link--YDF({ endorsedExternalURI: "https://www.npmjs.com/package/qs" }) qs] в качестве
        #[+Term--YDID десериализатора].
      Этот метод уже работает с #[+Keyword--YDID вложенными] #[+Term--YDID объектами] и #[+Term--YDID массивами],
        хотя конечно, #[+Keyphrase--YDID только в рамках поддерживаемых нотаций], однако предлагается конфигурация.
      Тем не&nbsp;менее, #[+Keyword--YDID автоматически] #[+Term--YDID строки] в #[+Term--YDID числа] эта библиотека
        #[+Keyword--YDID не]&nbsp;преобразует, что скорее хорошо, чем плохо, так иначе на анализ каждой строки тратились
