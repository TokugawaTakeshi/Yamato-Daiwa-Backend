block append SpecificContent

  article

    //- ━━━ Параметры поиска маршрутов ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    h1.Article-Heading1= topHeading

    +TutorialCodeIsNotOpimizedForProductionWarning

    p.Article-Paragraph
      | Если Вы, следуя нашей настойчивой рекомендации изучать уроки в предложенной последовательности, подробно
      |   ознакомились с
      |
      +Link--YDF({ internalURI: localizedRouting.tutorials.$children.routingAndControllers.$URI }) предыдущим уроком
      | , где разбиралась работа с #[+Term--YDID параметрами путей маршрутов], то работа с
      | #[+Term--YDID параметрами поиска] (#[+Term--YDID запроса]) Вам покажется аналогичной:

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.TypeScript }): :code_listing--yda
        export default class ProductController extends Controller {

          @Controller.RouteHandler({
            HTTP_Method: HTTP_Methods.get,
            pathTemplate: "products"
          })
          public async generateProductsPage(request: Request, response: Response): Promise<void> {

            const {
              fullOrPartialProductTitle,
              paginationPageNumber,
              itemsCountPerPaginationPage,
            }: Readonly<{
              fullOrPartialProductTitle: string;
              paginationPageNumber: number;
              itemsCountPerPaginationPage: number;
            }> = request.validateAndProcessURI_QueryParameters({
              fullOrPartialProductTitle: {
                type: String,
                isUndefinedForbidden: false,
                isNullForbidden: true,
                minimalCharactersCount: 2
              },
              paginationPageNumber: {
                preValidationModifications: convertPotentialStringToNumberIfPossible,
                type: Number,
                isUndefinedForbidden: true,
                isNullForbidden: true,
                isNaN_Forbidden: true,
                numbersSet: RawObjectDataProcessor.NumbersSets.naturalNumber
              },
              itemsCountPerPaginationPage: {
                preValidationModifications: convertPotentialStringToNumberIfPossible,
                type: Number,
                isUndefinedForbidden: true,
                isNullForbidden: true,
                isNaN_Forbidden: true,
                numbersSet: RawObjectDataProcessor.NumbersSets.naturalNumber
              }
            });

            console.table({
              name: fullOrPartialProductTitle,
              page: paginationPageNumber,
              size: itemsCountPerPaginationPage,
            });

            return response.submitWithSuccess({
              HTML_Content: "<h1>Products list</h1>"
            });

          }

        }

    p.Article-Paragraph.
      Однако, с #[+Term--YDID параметрами поиска] есть определённые тонкости, из-за которых пришлось вынести
        соответствующий материал по ним в этот отдельный урок.


    //- ┅┅┅ Теория ┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅
    +Heading--YDF({
      level: 2,
      text: localizedSectioning.theory.$heading,
      HTML_ID: localizedSectioning.theory.$anchor
    }).Article-Heading2

    p.Article-Paragraph.
      #[+Keyword--YDID Изначально] #[+Term--YDID параметры поиска], будучи #[+Keyword--YDID частью]
        #[+ImportantEntity--YDID URI], являются #[+Keyword--YDID единой] #[+Term--YDID строкой], которую называют
        #[+Term--YDID «query»] («запрос») или #[+Term--YDID «search»] («поиск»).
      Как нетрудно заметить, #[+Keyword--YDID оба] термина #[+Keyword--YDID довольно]
        #[+Keyword__Contrast--YDID многозначные], потому употребляя их, #[+Keyword--YDID необходимо] уточнить,
        что речь идёт именно о #[+Keyword--YDID составляющей] #[+ImportantEntity--YDID URI].

    +SingleImageViewer--YDF({
      imageURI: "@AssociatedWithPages/Tutorials/03-RouteQueryParameters/Images/Tutorials-QueryParameters-1",
      imageAlternateText:
          "Параметры запроса (поиска) — часть URI, отделённая от пути вопросительным знаком, однако после неё могут " +
            "идти и другие части URI, например отделённый решёткой хэш, хотя последний актуален для клиентской, " +
            "но не серверной разработки.",
      autoAspectRatioByYDA: true
    })

    p.Article-Paragraph.
      Называемая #[+Term--YDID «поиском»] часть #[+ImportantEntity--YDID URI] отделена #[+Term--YDID вопросительным знаком]
        от другой части, именуемой #[+Term--YDID «путём»] (была подробно рассмотрена в предыдущем уроке) .
      После него идёт #[+Keyphrase--YDID представленный в виде #[+Term--YDID строки]]
        #[+Term__Contrast--YDID ассоциативный массив].

    +SingleImageViewer--YDF({
      imageURI: "@AssociatedWithPages/Tutorials/03-RouteQueryParameters/Images/Tutorials-QueryParameters-2",
      imageAlternateText:
          "В Параметрах запроса (поиска) URI, каждый ключ отделён от соответствующего ему значения знаком =, а пары" +
            "«ключ-значение» отделены друг от друга знаком &.",
      autoAspectRatioByYDA: true
    })

    ul.Article-UnorderedList

      li.
        #[+Keyword--YDID Каждый] #[+Term--YDID ключ] отделён от #[+Keyphrase--YDID соответствующего ему]
          #[+Term--YDID значения] знаком #[+ImportantEntity--YDID =].

      li.
        #[+Term--YDID Пары «ключ-значение»] отделены друг от друга знаком #[+ImportantEntity--YDID &].

    p.Article-Paragraph.
      Именно в таком виде #[+Term--YDID параметры поиска] отправляются с клиентской стороны на серверную (или с одного
        сервера на другой), но это #[+Keyword--YDID не]&nbsp;тот вид, в котором удобно с ними работать на
        при обработке #[+Term--YDID запроса].
      Поэтому обрабатывая #[+Term--YDID запрос] на сервере, необходимо #[+Keyword--YDID проанализировать]
      #[+Term--YDID параметры поиска], если таковые ожидаются на конкретном #[+Term--YDID маршруте], и затем
        преобразовать их в удобный для обработки вид.

    p.Article-Paragraph.
      И вот в этом как раз проблема и заключается.
      Дело в том, что #[+Keyword--YDID не]&nbsp;существует единого стандарта, который предписывает, как интерпретировать
        те или иные #[+Term--YDID параметры поиска].
      Если в случае в #[+Term--YDID параметрами] #[+Keyword--YDID путей] #[+Term__Contrast--YDID маршрутов] работа
        в подавляющем большинстве случаев работа идёт со #[+Term--YDID строковыми] или #[+Term--YDID числовыми] значениями,
        то в случае с #[+Term--YDID параметрами] #[+Keyword--YDID поиска] востребованы и #[+Term--YDID булевский] тип,
        и #[+Term--YDID массивы] (#[+Keyword--YDID как] индексные, #[+Keyword--YDID так и] ассоциативные),
        а в некоторых случаях даже многоуровневые #[+Term--YDID массивы] и #[+Term--YDID объекты].
      Конечно, последних лучше избегать, так как они сильно запутывают #[+ImportantEntity--YDID API], но иногда это
        не&nbsp;под нашим контролем (например, если используется сторонние сервисы или важный заказчик просит именно
        такую сложную #[+ImportantEntity--YDID API]).


    //- ╍╍╍ Десериализация ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      text: localizedSectioning.theory.$children.deserialization.$heading,
      HTML_ID: localizedSectioning.theory.$children.deserialization.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      Итак, как и в случае с #[+Term--YDID параметрами путей маршрутов], #[+Keyword--YDID изначально]
        #[+Keyword__Contrast--YDID все] #[+Term--YDID параметры поиска] являются #[+Keyword--YDID строками] (вернее
        даже #[+Keyword--YDID подстроками] #[+Keyword__Contrast--YDID единой] #[+Term--YDID строки]).
      Подобно #[+Term--YDID параметрам путей маршрутов], хорошо было бы и #[+Term--YDID параметры поиска]
        преобразовать в обычный #[+Term--YDID объект], чтобы с ними было легко работать.
      Преобразование в #[+Term--YDID объект] представленных в виде единой #[+Term--YDID строки] данных типа
        #[+Term--YDID «массив»], подобных #[+Term--YDID параметрам поиска], называется
        #[+DefinableTerm--YDID десериализацией].
      Что имеется для этого из нативного #[+ImportantEntity--YDID API]?

    p.Article-Paragraph.
      Первый инструмент — это
        #[+Link--YDF({ unendorsedExternalURI: "https://developer.mozilla.org/ru/docs/Web/API/URL" }) WHATWG URL].
      Про #[+ImportantEntity--YDID WHATWG] пришлось упомянуть
        потому, что в старых версиях #[+ImportantEntity--YDID Node.js] использовалась другая реализация
        #[+ImportantEntity--YDID URL], которая теперь является устаревшей, а потому нерекомендуемой.
      И тут сразу же упомянутая выше путаница с тем, что такое #[+ImportantEntity--YDID URL], а что —
        #[+ImportantEntity--YDID URI].
      #[+Keyword--YDID Нативный] #[+Term--YDID объект] #[+Term--YDID запроса] (тип
        #[+ImportantEntity__Code--YDID HTTP.Request]) имеет #[+Term--YDID свойство] #[+ImportantEntity__Code--YDID url],
        значение которого представляет собой
        #[+Keyword--YDID часть] #[+ImportantEntity--YDID URI], #[+Keyphrase--YDID начинающуюся с #[+Keyword--YDID пути]],
        при этом #[+Term--YDID объект] #[+ImportantEntity--YDID WHATWG URL] может быть создан #[+Keyword--YDID только]
        #[+Keyword__Contrast--YDID если] указан #[+Term--YDID источник] наподобие
        #[+SecondaryEntity__Code--YDID http://localhost:80/].
      Если мы посмотрим #[+ImportantEntity--YDID JSDoc]-описание к свойству
        #[+ImportantEntity__Code--YDID HTTP.Request.url] в пакете #[+ImportantEntity--YDID @types/node] (проверено
        для версии #[+ImportantEntity--YDID 22.15.31]), то там будет такой пример:

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.TypeScript }): :code_listing--yda
        new URL(`http://${process.env.HOST ?? 'localhost'}${request.url}`);

    p.Article-Paragraph.
      Из этого примера как бы следует, что «#[+ImportantEntity--YDID URL] — это
      #[+ImportantEntity__Code--YDID request.url] и ещё #[+Term--YDID источник]», что конечно с точки зрения логики
        является абсурдом, потому аналогичным образом можно сказать, что «руль машины — это руль машины и ещё педали».
      Но ввиду того, что эта #[+ImportantEntity--YDID API] не&nbsp;под нашим контролем, имеем что имеем.

    p.Article-Paragraph.
      Вернёмся к #[+Term--YDID параметрам запроса].
      В #[+Term__Contrast--YDID объекте] #[+ImportantEntity--YDID WHATWG URL] есть #[+Keyword--YDID два]
        #[+Term--YDID свойства], отвечающие за #[+Term--YDID параметры запроса]:

    dl.Article-DescriptionList

      dt #[+ImportantEntity__Code--YDID search]
      dd.
        Начинающаяся с #[+ImportantEntity--YDID ?] #[+Term--YDID подстрока], в виде которой представлены
          #[+Keyword--YDID все] #[+Term--YDID параметры запроса].
        На примере #[+SecondaryEntity__Code--YDID "https://example.com/?alpha=foo&bravo=bar"] у #[+Term--YDID свойства]
          #[+ImportantEntity__Code--YDID search] будет значение #[+SecondaryEntity__Code--YDID "?alpha=foo&bravo=bar"].

      dt #[+ImportantEntity__Code--YDID searchParams]
      dd
        | Особый вид #[+Term--YDID коллекции] типа #[+Term--YDID «ассоциативный массив»], похожий на
        |
        +Link--YDF({
          unendorsedExternalURI: "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Map"
        }) Map
        | .
        | Его ключи и значения можно перебрать в цикле, а доступ к конкретному значению
        |   осуществляется как в #[+ImportantEntity--YDID Map] — с помощью #[+Term--YDID метода]
        |   #[+ImportantEntity__Code--YDID get] (например #[+SecondaryEntity__Code--YDID searchParams.get("alpha")]).
        | Этот #[+Term--YDID метод] может вернуть #[+ImportantEntity__Code--YDID undefined], потому прежде чем можно
        |   будет полноценно пользоваться возвращённым значением, #[+ImportantEntity--YDID TypeScript] при строгих
        |   настройках обяжет сначала проверить его на #[+ImportantEntity__Code--YDID undefined] (что скорее хорошо,
        |   чем плохо).

    p.Article-Paragraph.
      Таким образом #[+Term--YDID коллекция] #[+ImportantEntity__Code--YDID searchParams] — это самое близкое из того,
        что нам надо, но #[+Keyword--YDID все] #[+Term--YDID параметры поиска], которые она содержит, имеют
        #[+Keyword--YDID строковый] #[+Term--YDID тип].
      Например, при
        #[+SecondaryEntity__Code--YDID ?fullOrPartialProductTitle=test&paginationPageNumber=1&itemsCountPerPaginationPage=20]
        вывод значения #[+Term--YDID свойства] #[+ImportantEntity__Code--YDID searchParams] будет:

    +ConsoleOutput--YDF.
      URLSearchParams {
          'fullOrPartialProductTitle' => 'test',
          'paginationPageNumber' => '1',
          'itemsCountPerPaginationPage' => '20' }

    p.Article-Paragraph
      | Другая альтернатива — нативный модуль
      |
      +Link--YDF({
        unendorsedExternalURI: "https://nodejs.org/docs/latest-v22.x/api/querystring.html"
      }) querystring
      | .
      | В отличие от #[+ImportantEntity--YDID WHATWG URL], он работает
      |   #[+Keyword--YDID уже]&nbsp;#[+Keyword__Contrast--YDID не] с цельными #[+ImportantEntity--YDID URI],
      |   а только с #[+Term--YDID подстрокой запроса]
      |   #[+Keyphrase--YDID #[+Keyword--YDID не] включая #[+Term--YDID вопросительный знак]].
      | Например если мы #[+Term--YDID методу] #[+ImportantEntity__Code--YDID parse]
      |   (имеет #[+Keyword--YDID алиас] #[+ImportantEntity__Code--YDID decode]) передать #[+Term--YDID строку],
      |   начинающуюся с #[+Term--YDID вопросительного знака], то он её воспримет как #[+Keyword--YDID часть]
      |   #[+Keyword__Contrast--YDID первого] #[+Term--YDID параметра запроса]:

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.TypeScript }): :code_listing--yda
        import Querystring from "node:querystring";

        console.log(
          Querystring.parse(
            "?fullOrPartialProductTitle=test&" +
              "paginationPageNumber=1&" +
              "itemsCountPerPaginationPage=20"
          )
        );

    +ConsoleOutput--YDF.
      [Object: null prototype] {
        '?fullOrPartialProductTitle': 'test',
        paginationPageNumber: '1',
        itemsCountPerPaginationPage: '20'
      }

    p.Article-Paragraph.
      Также по кавычкам, в которые обёрнуты значения мы видим, что как и в случае с #[+ImportantEntity--YDID WHATWG URL],
        числовые значения автоматически #[+Keyword--YDID не]&nbsp;преобразуются в числовой тип.
      Однако в отличие от #[+ImportantEntity--YDID WHATWG URL], #[+ImportantEntity--YDID querystring] уже
        распознаёт #[+Term--YDID массивы].
      Допустим теперь мы в добавок ко всем указанным ранее #[+Term--YDID параметрам запроса] хотим найти товары
        только категорий с идентификаторами #[+SecondaryEntity--YDID 1] и #[+SecondaryEntity--YDID 2]:

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.TypeScript }): :code_listing--yda
        const serializedQueryParameters: string =
            "fullOrPartialProductTitle=test&" +
            "paginationPageNumber=1&" +
            "itemsCountPerPaginationPage=20&" +
            "categoryID=1&" +
            "categoryID=2";

    p.Article-Paragraph.
      #[+ImportantEntity--YDID WHATWG URL] добавит в #[+Term--YDID коллекцию] #[+Keyword--YDID два]
        #[+Term--YDID элемента] с #[+Keyword--YDID одинаковыми] ключами, в чём важное его отличие от
        #[+ImportantEntity--YDID Map], где дублирование ключей #[+Keyword--YDID невозможно]:

    +ConsoleOutput--YDF.
      URLSearchParams {
        'fullOrPartialProductTitle' => 'test',
        'paginationPageNumber' => '1',
        'itemsCountPerPaginationPage' => '20',
        'categoryID' => '1',
        'categoryID' => '2' }

    p.Article-Paragraph.
      А #[+ImportantEntity--YDID querystring] #[+Term--YDID свойству] #[+SecondaryEntity__Code--YDID categoryID]
        установит #[+Term--YDID массив] в качестве значения:

    +ConsoleOutput--YDF.
      [Object: null prototype] {
        fullOrPartialProductTitle: 'test',
        paginationPageNumber: '1',
        itemsCountPerPaginationPage: '20',
        categoryID: [ '1', '2' ]
      }

    p.Article-Paragraph.
      Но не&nbsp;следует забывать, что #[+Keyword--YDID нет]&nbsp;такого стандарта, при который однозначно устанавливает,
        как #[+Term--YDID десериализовать] #[+Term__Contrast--YDID массивы], а потому повтор ключей в
        #[+Term--YDID подстроке запроса] — это формат, который понимает #[+ImportantEntity--YDID querystring], но он
        #[+Keyword--YDID не]&nbsp;является единственным возможным.
      Есть, например, формат с квадратными скобками и явным #[+Term--YDID индексом массива]:

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.TypeScript }): :code_listing--yda
        const serializedQueryParameters: string =
            "fullOrPartialProductTitle=test&" +
            "paginationPageNumber=1&" +
            "itemsCountPerPaginationPage=20&" +
            "categoryID[0]=1&" +
            "categoryID[1]=2";

    p.Article-Paragraph.
      #[+Keyword--YDID Ни]&nbsp;#[+ImportantEntity--YDID WHATWG URL],
        #[+Keyword--YDID ни]&nbsp;#[+ImportantEntity__Code--YDID querystring] этого формата
        #[+Keyword--YDID не]&nbsp;поймут:

    +ConsoleOutput--YDF.
      URLSearchParams {
        'fullOrPartialProductTitle' => 'test',
