        #[+Term__Contrast--YDID параметры поиска], а потом снова их #[+Term--YDID десериализовать], то полученный
        #[+Keyword--YDID десериализованный] #[+Term--YDID объект] #[+Keyword--YDID должен] быть
        #[+Keyword__Contrast--YDID эквивалентным] начальному
