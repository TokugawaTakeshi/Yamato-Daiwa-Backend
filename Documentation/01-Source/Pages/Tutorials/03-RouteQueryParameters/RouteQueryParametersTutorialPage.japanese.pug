    p.Article-Paragraph.
      最後に、#[+Keyword--YDID 真偽値の]#[+Term--YDID クエリパラメータ]を考察。
      簡単に言うと、#[+ImportantEntity--YDID WHATWG URL]にせよ#[+ImportantEntity--YDID querystring]にせよ
        #[+ImportantEntity--YDID URI]内の#[+ImportantEntity__Code--YDID true]・#[+ImportantEntity__Code--YDID false]は
        #[+Keyword--YDID 単なる]#[+Keyword__Contrast--YDID 文字列]に過ぎない。

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.TypeScript }): :code_listing--yda
        const serializedQueryParameters: string =
