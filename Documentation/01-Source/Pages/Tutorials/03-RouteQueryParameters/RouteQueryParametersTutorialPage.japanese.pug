        @Controller.RouteHandler({
          HTTP_Method: HTTP_Methods.get,
          pathTemplate: "products"
        })
        public async generateProductsPage(request: Request, response: Response): Promise<void> {

          const {
            fullOrPartialProductTitle,
            paginationPageNumber,
            itemsCountPerPaginationPage,
          }: Readonly<{
            fullOrPartialProductTitle: string;
            paginationPageNumber: number;
            itemsCountPerPaginationPage: number;
          }> = request.validateAndProcessURI_QueryParameters({
            fullOrPartialProductTitle: {
              type: String,
              isUndefinedForbidden: false,
              isNullForbidden: true,
              minimalCharactersCount: 2
            },
            paginationPageNumber: {
              preValidationModifications: convertPotentialStringToNumberIfPossible,
              type: Number,
              isUndefinedForbidden: true,
              isNullForbidden: true,
              isNaN_Forbidden: true,
              numbersSet: RawObjectDataProcessor.NumbersSets.naturalNumber
            },
            itemsCountPerPaginationPage: {
              preValidationModifications: convertPotentialStringToNumberIfPossible,
              type: Number,
              isUndefinedForbidden: true,
              isNullForbidden: true,
              isNaN_Forbidden: true,
              numbersSet: RawObjectDataProcessor.NumbersSets.naturalNumber
            }
          });

          console.table({
            fullOrPartialProductTitle,
            paginationPageNumber,
            itemsCountPerPaginationPage
          });

          return response.submitWithSuccess({
            HTML_Content: "<h1>Products list</h1>"
          });

        }

    p.Article-Paragraph.
      規定では#[+ImportantEntity--YDID YDB]は#[+Link--YDF({ endorsedExternalURI: "https://www.npmjs.com/package/qs" }) qs]
        ライブラリの#[+ImportantEntity__Code--YDID parse]#[+Term--YDID メソッド]を#[+Term--YDID デセリアライザ]として使用する。
      此の#[+Term--YDID メソッド]は、#[+Keyphrase--YDID サポートされている記法の範囲内であれば（設定も可能）]、#[+Keyword--YDID 多層]
        #[+Term--YDID オブジェクト]や#[+Term--YDID 配列]も扱う事が出来る。
      それでも、此のライブラリは#[+Keyword--YDID 自動的に]#[+Term--YDID 文字列]を#[+Term--YDID 数値]に変換#[+Keyword--YDID しない]。
      此れは、各#[+Term--YDID 文字列]の解析に計算リソースを浪費しない為であり、寧ろ好ましい事と言える。

    p.Article-Paragraph.
      #[+Term--YDID 逆シリアル化]が終わり次第、得られた#[+Term--YDID オブジェクト]は#[+ImportantEntity--YDID RawObjectProcessor]に渡される。
      #[+ImportantEntity--YDID RawObjectProcessor]は#[+Term--YDID オブジェクト]のバリデーションだけでなく、必要に応じて変換する事も出来る。
      但し勿論、変換やバリデーションは#[+Term--YDID 逆シリアル化]のアルゴリズムを#[+Keyword--YDID 考慮しなければならない]。

    p.Article-Paragraph
